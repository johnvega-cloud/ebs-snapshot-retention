{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Discover",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeVolumes",
        "ec2:DescribeSnapshots",
        "ec2:DescribeRegions"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SnapshotAnyVolume",
      "Effect": "Allow",
      "Action": "ec2:CreateSnapshot",
      "Resource": "arn:aws:ec2:*:*:volume/*"
    },
    {
      "Sid": "CreateOnlyManagedSnapshots",
      "Effect": "Allow",
      "Action": "ec2:CreateSnapshot",
      "Resource": "arn:aws:ec2:*::snapshot/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/ebs-backup:managed-by": "ebs-snapshot-backup"
        }
      }
    },
    {
      "Sid": "TagOnlyWhileCreatingSnapshots",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:*::snapshot/*",
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": "CreateSnapshot"
        }
      }
    },
    {
      "Sid": "DeleteOnlyManagedSnapshots",
      "Effect": "Allow",
      "Action": "ec2:DeleteSnapshot",
      "Resource": "arn:aws:ec2:*::snapshot/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/ebs-backup:managed-by": "ebs-snapshot-backup"
        }
      }
    },
    {
      "Sid": "NeverDeleteProtectedSnapshots",
      "Effect": "Deny",
      "Action": "ec2:DeleteSnapshot",
      "Resource": "arn:aws:ec2:*::snapshot/*",
      "Condition": {
        "Null": {
          "aws:ResourceTag/DoNotDelete": "false"
        }
      }
    }
  ]
}
